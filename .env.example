# Local development settings. The app reads os.environ directly; nothing loads
# this file automatically. Export these in your shell (see README). Never commit secrets.

SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Leave unset locally to use SQLite (db.sqlite3).
# DATABASE_URL=postgres://user:password@localhost:5432/emanhomes

# Leave unset locally to store uploads in ./media. Required on Render.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Print emails to the console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# LEAD_NOTIFICATION_EMAIL=
# EMAIL_TIMEOUT=10

# ANALYTICS_MEASUREMENT_ID=
# Server-error alerts go here (comma-separated); defaults to LEAD_NOTIFICATION_EMAIL.
# ADMIN_EMAILS=
# Canonical site address for share previews and structured data.
# SITE_URL=https://emanhomes.com
# SITE_NOINDEX=false
# LOG_LEVEL=INFO
